# Apple Silicon only. Homebrew no longer builds bottles for Intel, so these would
# all compile from source there. On Intel, bin/setup-mise.sh installs prebuilt
# binaries of the same tools instead, and git comes from the Xcode Command Line
# Tools. Keep this list in sync with INTEL_TOOLS in bin/setup-mise.sh.
if Hardware::CPU.arm?
  brew "gh"
  brew "git"
  brew "lua-language-server"
  brew "mise"
  brew "neovim"
  brew "starship"
  brew "stylua"
  brew "tmux"
end

